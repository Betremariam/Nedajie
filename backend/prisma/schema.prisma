// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider   = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Admin {
  id                  String    @id @default(cuid())
  name                String
  email               String    @unique
  password            String
  role                AdminRole
  isApproved          Boolean   @default(true)
  isBlocked           Boolean   @default(false)
  mustChangePassword  Boolean   @default(false)
  region              String?
  companyName         String?
  documentPath        String?
  createdAt           DateTime  @default(now())

  vehicles        Vehicle[]
  farmers         Farmer[]
  millHouseOwners MillHouseOwner[]
  otherUsers      OtherUser[]
}

enum AdminRole {
  federal
  super
  approver
  register
}

model Vehicle {
  id              String   @id @default(cuid())
  ownerName       String
  phone           String   @unique
  vehicleType     VehicleType
  carPlate        String
  qrCode          String?
  password        String
  dailyLimitUsed  Float    @default(0)
  lastFuelDate    DateTime?
  fullCapacity    Float    @default(0)
  isApproved      Boolean  @default(false)
  documentPath    String?
  region          String?
  approvedBy      Admin?   @relation(fields: [approvedById], references: [id])
  approvedById    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt
  transactions    FuelTransaction[]
}

enum VehicleType {
  bajaj
  taxi
  heavy
  car
  truck
  bus
  motorcycle
  boat
  ship
  machinery
  ambulance
  other
}

model Farmer {
  id               String   @id @default(cuid())
  fullName         String
  kebele           String
  woreda           String
  phoneNumber      String   @unique
  landSize         Float    @default(0) // In hectares
  litersUsed15Days Float    @default(0)
  limitStartDate   DateTime? @default(now())
  expiryDate       DateTime? // For rainy season / letter limit
  documentPath     String?
  region           String?
  approvedBy       Admin?   @relation(fields: [approvedById], references: [id])
  approvedById     String?
  isApproved       Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @default(now()) @updatedAt

  transactions     FuelTransaction[]
}

model FuelAttendant {
  id           String   @id @default(cuid())
  name         String
  phone        String   @unique
  password     String
  stationName  String
  city         String
  region       String?
  isApproved   Boolean  @default(false)
  isEnabled    Boolean  @default(true)
  documentPath String
  owner        FuelStation? @relation(fields: [ownerId], references: [id])
  ownerId      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt
}

model FuelStation {

  id                  String   @id @default(cuid())
  name                String   // Owner Name
  email               String   @unique
  password            String
  role                String   @default("stationOwner")
  region              String
  zone                String
  woreda              String
  city                String
  stationName         String   @unique
  
  isApproved          Boolean  @default(true)
  isBlocked           Boolean  @default(false)
  mustChangePassword  Boolean  @default(false)
  
  // Documents
  legalDocPath        String?
  fuelLicensePath     String?
  constructionDocPath String?
  safetyCertPath      String?
  envClearancePath    String?
  pumpCalibrationPath String?
  
  createdAt           DateTime @default(now())
  updatedAt           DateTime @default(now()) @updatedAt
  
  attendants          FuelAttendant[]
}
model FuelDelivery {
  id                String             @id @default(cuid())
  date              String
  customer          String
  destination       String
  citter            String
  fdcNo             String
  volume            Float
  region            String
  fuelType          FuelType
  status            FuelDeliveryStatus @default(PENDING)
  isConfirmed       Boolean            @default(false)
  
  federalLetterPath      String?
  superAdminSignedPath   String?
  ownerSignedPath        String?

  superAdminId      String?
  ownerId           String?
  createdAt         DateTime           @default(now())
}

enum FuelDeliveryStatus {
  PENDING
  SUPERADMIN_ACCEPTED
  OWNER_ACCEPTED
  REJECTED
}

enum FuelType {
  diesel
  benzene
}

model FuelReceived {
  id          String    @id @default(cuid())
  station     FuelStock @relation(fields: [stationId], references: [id])
  stationId   String
  stationName String
  city        String
  region      String?
  gasType     FuelType
  liters      Float
  date        DateTime  @default(now())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt
}

model FuelStock {
  id              String   @id @default(cuid())
  stationName     String
  woreda          String?
  city            String
  region          String?
  gasType         FuelType
  litersReceived  Float
  litersDispensed Float    @default(0)
  date            DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt

  fuelReceived    FuelReceived[]
}

model FuelTransaction {
  id                String          @id @default(cuid())
  vehicle           Vehicle?        @relation(fields: [vehicleId], references: [id])
  vehicleId         String?
  farmer            Farmer?         @relation(fields: [farmerId], references: [id])
  farmerId          String?
  millHouseOwner    MillHouseOwner? @relation(fields: [millHouseOwnerId], references: [id])
  millHouseOwnerId  String?
  otherUser         OtherUser?      @relation(fields: [otherUserId], references: [id])
  otherUserId       String?
  gasType           FuelType
  liters            Float
  stationName       String
  attendantName     String
  city              String
  region            String?
  date              DateTime        @default(now())
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @default(now()) @updatedAt
}

model OtherUser {
  id                 String   @id @default(cuid())
  fullName           String
  phoneNumber        String   @unique
  password           String   @default("")
  fuelType           FuelType
  totalAllowedLiters Float    @default(0) // One-time bucket
  litersUsed         Float    @default(0)
  dailyLimitUsed     Float    @default(0) // Legacy
  maxUses            Int      @default(-1) // -1 for unlimited
  useCount           Int      @default(0)
  documentPath       String?
  region             String?
  isApproved         Boolean  @default(false)
  approvedBy         Admin?   @relation(fields: [approvedById], references: [id])
  approvedById       String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @default(now()) @updatedAt

  transactions       FuelTransaction[]
}

model MillHouseOwner {
  id             String   @id @default(cuid())
  fullName       String
  kebele         String
  woreda         String
  phoneNumber    String   @unique
  numberOfMills  Int      @default(1)
  fuelType       FuelType @default(diesel)
  dailyLimit     Float    @default(0)
  documentPath   String?
  region         String?
  isApproved     Boolean  @default(false)
  approvedBy     Admin?   @relation(fields: [approvedById], references: [id])
  approvedById   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt

  transactions   FuelTransaction[]
}
